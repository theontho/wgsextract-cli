{
  "name": "gui-for-cli-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build",
    "test": "npm run build && node scripts/run-node-tests.mjs",
    "tauri": "cd web/packagers/tauri && tauri",
    "tauri:prepare-node": "node scripts/prepare-tauri-node.mjs",
    "tauri:build": "npm run tauri:prepare-node && npm run build && node scripts/run-tauri.mjs build",
    "tauri:dist": "npm run tauri:prepare-node && npm run build && node scripts/tauri-build-dist.mjs",
    "tauri:dev": "npm run tauri:prepare-node && npm run build && node scripts/run-tauri.mjs dev",
    "vendor-icons": "node scripts/update-bootstrap-icons.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "start": "npm run build && node dist/web/src/server/main.js",
    "bundle:test": "npm run build && node dist/web/src/server/bundle-test-cli.js",
    "bundle:validate": "npm run build && node dist/web/src/server/bundle-validate-cli.js",
    "dup": "cd .. && npx --prefix app jscpd --config .jscpd.json .",
    "dup:ci": "cd .. && npx --prefix app jscpd --config .jscpd.json --reporters console ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "bootstrap-icons": "^1.13.2",
    "jscpd": "^5.4.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "^7.5.22",
    "postcss": "^8.5.31"
  }
}
