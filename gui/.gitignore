# Local machine and secrets
.DS_Store
.devconfig.toml
.env
.env.*

# Package manager and SDK caches
.node/
.venv/

# Repository output workspaces and runner-local drive roots
/c/
out/*
tmp/*
!out/.gitkeep
!tmp/.gitkeep

# Logs and Python caches
*.log
__pycache__/
*.py[cod]
.pytest_cache/

# Bundle runtime state
examples/*/runtime/
examples/*/genomes/
examples/*/output/
examples/*/reference/
examples/*/settings/
tests/conformance/*/settings/

# TypeScript build outputs and dependencies
app/dist/
app/.cache/
app/node_modules/
app/web/packagers/tauri/gen/
app/web/packagers/tauri/permissions/autogenerated/
app/web/packagers/tauri/resources/node/
app/web/packagers/tauri/resources/EmbeddedBundle/
app/web/packagers/tauri/resources/branding.json
app/web/packagers/tauri/target/
examples/*/temp/
examples/*/logs/
