+    static const double ln2_hi = 0x1.62e42fee00000p-1, ln2_lo = 0x1.a39ef35793c76p-33;
+    static const double Lp1 = 0x1.5555555555593p-1, Lp2 = 0x1.999999997fa04p-2,
+                        Lp3 = 0x1.2492494229359p-2, Lp4 = 0x1.c71c51d8e78afp-3,
+                        Lp5 = 0x1.7466496cb03dep-3, Lp6 = 0x1.39a09d078c69fp-3,
+                        Lp7 = 0x1.2f112df3e5244p-3;
+    using detail::asdouble;
+    using detail::asuint64;
+    int32_t hx = (int32_t) (asuint64(x) >> 32), ax = hx & 0x7fffffff, hu = 0, k = 1;
+    double f = 0, c = 0;
+    if (hx < 0x3FDA827A) {
+        if (ax >= 0x3ff00000) return x == -1.0 ? -HUGE_VAL : std::nan("");
+        if (ax < 0x3e200000) return ax < 0x3c900000 ? x : std::fma(-(x * x), 0.5, x);
+        if (hx > 0 || hx <= (int32_t) 0xbfd2bec3) {
+            k = 0;
+            f = x;
+            hu = 1;
+        }
+    } else if (hx >= 0x7ff00000) {
+        return x + x;
+    }
+    if (k != 0) {
+        double u;
+        if (hx < 0x43400000) {
+            u = 1.0 + x;
+            hu = (int32_t) (asuint64(u) >> 32);
+            k = (hu >> 20) - 1023;
+            c = (k > 0) ? 1.0 - (u - x) : x - (u - 1.0);
+            c /= u;
+        } else {
+            u = x;
+            hu = (int32_t) (asuint64(u) >> 32);
+            k = (hu >> 20) - 1023;
+            c = 0;
+        }
+        hu &= 0x000fffff;
+        uint64_t low = asuint64(u) & 0xffffffffULL;
+        if (hu < 0x6a09e) {
+            u = asdouble((uint64_t) (uint32_t) (hu | 0x3ff00000) << 32 | low);
+        } else {
+            k += 1;
+            u = asdouble((uint64_t) (uint32_t) (hu | 0x3fe00000) << 32 | low);
+            hu = (0x00100000 - hu) >> 2;
+        }
+        f = u - 1.0;
+    }
+    double hfsq = 0.5 * f * f, kd = (double) k;
+    if (hu == 0) {
+        if (f == 0.0) return k == 0 ? 0.0 : std::fma(kd, ln2_hi, std::fma(kd, ln2_lo, c));
+        double R = hfsq * std::fma(-f, 0.66666666666666666, 1.0);
+        if (k == 0) return f - R;
+        return std::fma(kd, ln2_hi, -((R - std::fma(kd, ln2_lo, c)) - f));
+    }
+    double s = f / (2.0 + f), z = s * s, z2 = z * z, z4 = z2 * z2, z6 = z4 * z2;
+    double R2 = std::fma(z, Lp3, Lp2), R3 = std::fma(z, Lp5, Lp4), R4 = std::fma(z, Lp7, Lp6);
+    double R = std::fma(z6, R4, std::fma(z4, R3, std::fma(z, Lp1, z2 * R2)));
+    if (k == 0) return f - (hfsq - s * (hfsq + R));
+    return std::fma(kd, ln2_hi, -((hfsq - (s * (hfsq + R) + std::fma(kd, ln2_lo, c))) - f));
+}
+
+// fdlibm __ieee754_log10 (glibc 2.39 dbl-64/e_log10.c).
+__attribute__((noinline)) inline double log10(double x) {
+    int64_t hx;
+    std::memcpy(&hx, &x, 8);
+    int32_t k = 0;
+    if (hx < INT64_C(0x0010000000000000)) {
+        if ((hx & INT64_C(0x7fffffffffffffff)) == 0) return -HUGE_VAL;
+        if (hx < 0) return std::nan("");
+        k -= 54;
+        x *= 0x1p54;
+        std::memcpy(&hx, &x, 8);
+    }
+    if (hx >= INT64_C(0x7ff0000000000000)) return x + x;
+    k += (int32_t) (hx >> 52) - 1023;
+    int64_t i = (int64_t) (((uint64_t) (int64_t) k & UINT64_C(0x8000000000000000)) >> 63);
+    hx = (hx & INT64_C(0x000fffffffffffff)) | ((0x3ff - i) << 52);
+    double y = (double) (k + i);
+    std::memcpy(&x, &hx, 8);
+    double z = std::fma(y, 0x1.9fef311f12b36p-42, 0x1.bcb7b1526e50ep-2 * detail::log(x));
+    return std::fma(y, 0x1.34413509f6p-2, z);
+}
+
+// fdlibm __ieee754_log10f (glibc 2.39 flt-32/e_log10f.c).
+__attribute__((noinline)) inline float log10f(float x) {
+    int32_t hx;
+    std::memcpy(&hx, &x, 4);
+    int32_t k = 0;
+    if (hx < 0x00800000) {
+        if ((hx & 0x7fffffff) == 0) return -HUGE_VALF;
+        if (hx < 0) return std::nanf("");
+        k -= 25;
+        x *= 0x1p25f;
+        std::memcpy(&hx, &x, 4);
+    }
+    if (hx >= 0x7f800000) return x + x;
+    k += (hx >> 23) - 127;
+    int32_t i = (int32_t) (((uint32_t) k & 0x80000000u) >> 31);
+    hx = (hx & 0x007fffff) | ((0x7f - i) << 23);
+    float y = (float) (k + i);
+    std::memcpy(&x, &hx, 4);
+    float z = std::fma(y, 0x1.a84fb6p-21f, 0x1.bcb7b2p-2f * detail::logf(x));
+    return std::fma(y, 0x1.3441p-2f, z);
+}
+
+#else
+
+inline double log10(double x) { return ::log10(x); }
+inline float log10f(float x) { return ::log10f(x); }
+inline double pow(double x, double y) { return ::pow(x, y); }
+inline double log1p(double x) { return ::log1p(x); }
+
+#endif
+
+}  // namespace wgse_libm
+
+#endif  // WGSE_LIBM_H
