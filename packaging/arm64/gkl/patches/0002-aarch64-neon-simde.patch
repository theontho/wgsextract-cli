diff --git a/src/main/native/pairhmm/neon-pairhmm.h b/src/main/native/pairhmm/neon-pairhmm.h
new file mode 100644
index 0000000..d50d507
--- /dev/null
+++ b/src/main/native/pairhmm/neon-pairhmm.h
@@ -0,0 +1,325 @@
+/*
+ * Native AArch64 NEON PairHMM kernel (WGS Extract port of GKL's AVX kernel).
+ *
+ * This is a line-for-line port of avx-pairhmm-template.h for 128-bit NEON.
+ * Each AVX vector (8 floats or 4 doubles) is held as a lo/hi pair of NEON
+ * registers, and every lane performs the same IEEE-754 operations in the
+ * same order as the AVX kernel:
+ *   M = (((M2 * pMM) + (X2 * pGAPM)) + (Y2 * pGAPM)) * distm
+ *   X = (M1 * pMX) + (X1 * pXX)
+ *   Y = (M1y * pMY) + (Y1 * pYY)
+ * With contraction disabled (-ffp-contract=off) the results are bit-identical
+ * to the x86 AVX kernel. The only changes are register-level: lane shifts use
+ * EXT instead of the AVX extract/insert sequence, and the anti-diagonal loop is
+ * unrolled by two so the M/X/Y history rotates by renaming instead of moves.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef WGSE_NEON_PAIRHMM_H
+#define WGSE_NEON_PAIRHMM_H
+
+#include <arm_neon.h>
+#include <stdint.h>
+
+#include <algorithm>
+
+#include "Context.h"
+#include "pairhmm_common.h"
+
+#define WGSE_ALWAYS_INLINE inline __attribute__((always_inline))
+
+namespace wgse_neon {
+
+template <class T> struct Lanes;
+
+template <> struct Lanes<float> {
+  typedef float32x4_t V;
+  typedef uint32x4_t U;
+  typedef uint32_t Mask;
+  static const int kHalf = 4;
+  static WGSE_ALWAYS_INLINE V add(V a, V b) { return vaddq_f32(a, b); }
+  static WGSE_ALWAYS_INLINE V sub(V a, V b) { return vsubq_f32(a, b); }
+  static WGSE_ALWAYS_INLINE V mul(V a, V b) { return vmulq_f32(a, b); }
+  static WGSE_ALWAYS_INLINE V div(V a, V b) { return vdivq_f32(a, b); }
+  static WGSE_ALWAYS_INLINE V dup(float x) { return vdupq_n_f32(x); }
+  static WGSE_ALWAYS_INLINE V load(const float* p) { return vld1q_f32(p); }
+  static WGSE_ALWAYS_INLINE V load_dup(const float* p) { return vld1q_dup_f32(p); }
+  static WGSE_ALWAYS_INLINE void store(float* p, V v) { vst1q_f32(p, v); }
+  static WGSE_ALWAYS_INLINE void store_top(float* p, V v) { vst1q_lane_f32(p, v, 3); }
+  static WGSE_ALWAYS_INLINE V lane0(float x) { return vsetq_lane_f32(x, vdupq_n_f32(0.0f), 0); }
+  /* [below[3], v[0], v[1], v[2]]: the AVX lane shift across one 128-bit half. */
+  static WGSE_ALWAYS_INLINE V shift_up(V below, V v) { return vextq_f32(below, v, 3); }
+  static WGSE_ALWAYS_INLINE U load_mask(const Mask* p) { return vld1q_u32(p); }
+  /* _mm256_blendv_ps: take `set` where the mask lane's sign bit is set. */
+  static WGSE_ALWAYS_INLINE V blend(U mask, V set, V clear) {
+    return vbslq_f32(vcltzq_s32(vreinterpretq_s32_u32(mask)), set, clear);
+  }
+  static WGSE_ALWAYS_INLINE U shl1(U mask) { return vshlq_n_u32(mask, 1); }
+};
+
+template <> struct Lanes<double> {
+  typedef float64x2_t V;
+  typedef uint64x2_t U;
+  typedef uint64_t Mask;
+  static const int kHalf = 2;
+  static WGSE_ALWAYS_INLINE V add(V a, V b) { return vaddq_f64(a, b); }
+  static WGSE_ALWAYS_INLINE V sub(V a, V b) { return vsubq_f64(a, b); }
+  static WGSE_ALWAYS_INLINE V mul(V a, V b) { return vmulq_f64(a, b); }
+  static WGSE_ALWAYS_INLINE V div(V a, V b) { return vdivq_f64(a, b); }
+  static WGSE_ALWAYS_INLINE V dup(double x) { return vdupq_n_f64(x); }
+  static WGSE_ALWAYS_INLINE V load(const double* p) { return vld1q_f64(p); }
+  static WGSE_ALWAYS_INLINE V load_dup(const double* p) { return vld1q_dup_f64(p); }
+  static WGSE_ALWAYS_INLINE void store(double* p, V v) { vst1q_f64(p, v); }
+  static WGSE_ALWAYS_INLINE void store_top(double* p, V v) { vst1q_lane_f64(p, v, 1); }
+  static WGSE_ALWAYS_INLINE V lane0(double x) { return vsetq_lane_f64(x, vdupq_n_f64(0.0), 0); }
+  static WGSE_ALWAYS_INLINE V shift_up(V below, V v) { return vextq_f64(below, v, 1); }
+  static WGSE_ALWAYS_INLINE U load_mask(const Mask* p) { return vld1q_u64(p); }
+  static WGSE_ALWAYS_INLINE V blend(U mask, V set, V clear) {
+    return vbslq_f64(vcltzq_s64(vreinterpretq_s64_u64(mask)), set, clear);
+  }
+  static WGSE_ALWAYS_INLINE U shl1(U mask) { return vshlq_n_u64(mask, 1); }
+};
+
+/* One AVX-width vector as two NEON registers (lanes 0..h-1 in lo). */
+template <class T> struct Vec {
+  typename Lanes<T>::V lo, hi;
+};
+
+template <class T> WGSE_ALWAYS_INLINE Vec<T> vload(const T* p) {
+  Vec<T> v = {Lanes<T>::load(p), Lanes<T>::load(p + Lanes<T>::kHalf)};
+  return v;
+}
+
+template <class T> WGSE_ALWAYS_INLINE Vec<T> vsplat(T x) {
+  Vec<T> v = {Lanes<T>::dup(x), Lanes<T>::dup(x)};
+  return v;
+}
+
+/* VEC_SET_LSE: x in lane 0, zero elsewhere. */
+template <class T> WGSE_ALWAYS_INLINE Vec<T> vlane0(T x) {
+  Vec<T> v = {Lanes<T>::lane0(x), Lanes<T>::dup(T(0))};
+  return v;
+}
+
+/*
+ * _vector_shift / _vector_shift_last: move every lane up by one, put
+ * shift_in[0] into lane 0 and (unless LAST) store the old top lane to *out.
+ */
+template <class T, bool LAST>
+WGSE_ALWAYS_INLINE void vshift(Vec<T>& v, const T* shift_in, T* out) {
+  typedef Lanes<T> L;
+  if (!LAST) L::store_top(out, v.hi);
+  v.hi = L::shift_up(v.lo, v.hi);
+  v.lo = L::shift_up(L::load_dup(shift_in), v.lo);
+}
+
+struct Probs;
+
+/*
+ * One anti-diagonal step (computeDistVec + computeMXY + the three shifts).
+ * On entry: M2/X2/Y2 hold the shifted t-2 vectors, M1/X1 the shifted t-1
+ * vectors, Y1 the unshifted Y(t-1) and My the unshifted M(t-1). On exit the
+ * slots hold the next step's values with each pair's roles swapped:
+ * M2 <- shifted M(t), X2 <- shifted X(t), Y1 <- shifted Y(t-1), Y2 <- Y(t),
+ * My <- M(t). The caller swaps (M2,M1), (X2,X1), (Y2,Y1) on the next call.
+ */
+template <class T, bool LAST>
+WGSE_ALWAYS_INLINE void step(Vec<T>& M2, const Vec<T>& M1, Vec<T>& X2, const Vec<T>& X1, Vec<T>& Y2, Vec<T>& Y1,
+                             Vec<T>& My, typename Lanes<T>::U& maskLo, typename Lanes<T>::U& maskHi,
+                             const Vec<T>& distm, const Vec<T>& oneMinusDistm, const Vec<T>& pMM,
+                             const Vec<T>& pGAPM, const Vec<T>& pMX, const Vec<T>& pXX, const Vec<T>& pMY,
+                             const Vec<T>& pYY, T* shiftM, T* shiftX, T* shiftY, int inIdx, int outIdx,
+                             Vec<T>& sumM, Vec<T>& sumX) {
+  typedef Lanes<T> L;
+  Vec<T> sel;
+  sel.lo = L::blend(maskLo, oneMinusDistm.lo, distm.lo);
+  sel.hi = L::blend(maskHi, oneMinusDistm.hi, distm.hi);
+  maskLo = L::shl1(maskLo);
+  maskHi = L::shl1(maskHi);
+
+  Vec<T> Mt, Xt, Yt;
+  Mt.lo = L::mul(L::add(L::add(L::mul(M2.lo, pMM.lo), L::mul(X2.lo, pGAPM.lo)), L::mul(Y2.lo, pGAPM.lo)), sel.lo);
+  Mt.hi = L::mul(L::add(L::add(L::mul(M2.hi, pMM.hi), L::mul(X2.hi, pGAPM.hi)), L::mul(Y2.hi, pGAPM.hi)), sel.hi);
+  Xt.lo = L::add(L::mul(M1.lo, pMX.lo), L::mul(X1.lo, pXX.lo));
+  Xt.hi = L::add(L::mul(M1.hi, pMX.hi), L::mul(X1.hi, pXX.hi));
+  Yt.lo = L::add(L::mul(My.lo, pMY.lo), L::mul(Y1.lo, pYY.lo));
+  Yt.hi = L::add(L::mul(My.hi, pMY.hi), L::mul(Y1.hi, pYY.hi));
+  My = Mt;
+
+  if (LAST) {
+    sumM.lo = L::add(sumM.lo, Mt.lo);
+    sumM.hi = L::add(sumM.hi, Mt.hi);
+    sumX.lo = L::add(sumX.lo, Xt.lo);
+    sumX.hi = L::add(sumX.hi, Xt.hi);
+  }
+  vshift<T, LAST>(Mt, shiftM + inIdx, shiftM + outIdx);
+  vshift<T, LAST>(Xt, shiftX + inIdx, shiftX + outIdx);
+  vshift<T, LAST>(Y1, shiftY + inIdx, shiftY + outIdx);
+  M2 = Mt;
+  X2 = Xt;
+  Y2 = Yt;
+}
+
+/* Runs `count` anti-diagonals starting at diagonal `first` (1-based). */
+template <class T, bool LAST>
+WGSE_ALWAYS_INLINE void run_diagonals(int first, int count, const typename Lanes<T>::Mask* laneMasks, Vec<T>& M2,
+                                      Vec<T>& M1, Vec<T>& X2, Vec<T>& X1, Vec<T>& Y2, Vec<T>& Y1, Vec<T>& My,
+                                      const Vec<T>& distm, const Vec<T>& oneMinusDistm, const Vec<T>& pMM,
+                                      const Vec<T>& pGAPM, const Vec<T>& pMX, const Vec<T>& pXX,
+                                      const Vec<T>& pMY, const Vec<T>& pYY, T* shiftM, T* shiftX, T* shiftY,
+                                      Vec<T>& sumM, Vec<T>& sumX) {
+  typedef Lanes<T> L;
+  const int lanes = 2 * L::kHalf;
+  typename L::U maskLo = L::load_mask(laneMasks);
+  typename L::U maskHi = L::load_mask(laneMasks + L::kHalf);
+  int k = 0;
+  for (; k + 1 < count; k += 2) {
+    int d = first + k;
+    step<T, LAST>(M2, M1, X2, X1, Y2, Y1, My, maskLo, maskHi, distm, oneMinusDistm, pMM, pGAPM, pMX, pXX, pMY, pYY,
+                  shiftM, shiftX, shiftY, d + lanes, d, sumM, sumX);
+    step<T, LAST>(M1, M2, X1, X2, Y1, Y2, My, maskLo, maskHi, distm, oneMinusDistm, pMM, pGAPM, pMX, pXX, pMY, pYY,
+                  shiftM, shiftX, shiftY, d + 1 + lanes, d + 1, sumM, sumX);
+  }
+  if (k < count) {
+    int d = first + k;
+    step<T, LAST>(M2, M1, X2, X1, Y2, Y1, My, maskLo, maskHi, distm, oneMinusDistm, pMM, pGAPM, pMX, pXX, pMY, pYY,
+                  shiftM, shiftX, shiftY, d + lanes, d, sumM, sumX);
+    std::swap(M1, M2);
+    std::swap(X1, X2);
+    std::swap(Y1, Y2);
+  }
+}
+
+template <class T> T compute_full_prob(testcase* tc) {
+  typedef Lanes<T> L;
+  typedef typename L::Mask MaskT;
+  const int lanes = 2 * L::kHalf;
+  const int maskBits = (int)(sizeof(MaskT) * 8);
+  const MaskT allOnes = (MaskT)~(MaskT)0;
+
+  const int ROWS = tc->rslen + 1;
+  const int COLS = tc->haplen + 1;
+  const int padded = ((ROWS + lanes - 1) / lanes) * lanes;
+  const int remainingRows = (ROWS - 1) % lanes;
+  const int stripes = (ROWS - 1) / lanes + (remainingRows != 0);
+  Context<T> ctx;
+
+  /* Per-row probabilities, `lanes` rows per stripe; row r lives at index r-1. */
+  T p_MM[padded], p_GAPM[padded], p_MX[padded], p_XX[padded], p_MY[padded], p_YY[padded], distm1D[padded];
+  T shiftOutM[ROWS + COLS + lanes], shiftOutX[ROWS + COLS + lanes], shiftOutY[ROWS + COLS + lanes];
+
+  const T zero = ctx._(0.0);
+  /* Casting is fine because the algorithm is intended to have limited precision. */
+  const T init_Y = ctx.INITIAL_CONSTANT / (T)(tc->haplen);
+  for (int s = 0; s < ROWS + COLS + lanes; s++) {
+    shiftOutM[s] = zero;
+    shiftOutX[s] = zero;
+    shiftOutY[s] = init_Y;
+  }
+  /* Padding rows of the last stripe only feed lanes above the result lane. */
+  for (int r = ROWS - 1; r < padded; r++) {
+    p_MM[r] = p_GAPM[r] = p_MX[r] = p_XX[r] = p_MY[r] = p_YY[r] = distm1D[r] = zero;
+  }
+  for (int r = 1; r < ROWS; r++) {
+    int _i = tc->i[r - 1] & 127;
+    int _d = tc->d[r - 1] & 127;
+    int _c = tc->c[r - 1] & 127;
+    p_MM[r - 1] = ctx.set_mm_prob(_i, _d);
+    p_GAPM[r - 1] = ctx._(1.0) - ctx.ph2pr[_c];
+    p_MX[r - 1] = ctx.ph2pr[_i];
+    p_XX[r - 1] = ctx.ph2pr[_c];
+    p_MY[r - 1] = ctx.ph2pr[_d];
+    p_YY[r - 1] = ctx.ph2pr[_c];
+    distm1D[r - 1] = ctx.ph2pr[tc->q[r - 1] & 127];
+  }
+
+  /* Haplotype match masks: bit (maskBits-1-k) of word w is column w*maskBits+k+1. */
+  const int numMaskVecs = (COLS + ROWS + maskBits - 1) / maskBits;
+  MaskT maskArr[numMaskVecs][NUM_DISTINCT_CHARS];
+  for (int vi = 0; vi < numMaskVecs; ++vi) {
+    for (int ci = 0; ci < NUM_DISTINCT_CHARS; ++ci) maskArr[vi][ci] = 0;
+    maskArr[vi][AMBIG_CHAR] = allOnes;
+  }
+  for (int col = 1; col < COLS; ++col) {
+    int mIndex = (col - 1) / maskBits;
+    int mOffset = (col - 1) % maskBits;
+    MaskT bitMask = ((MaskT)1) << (maskBits - 1 - mOffset);
+    char hapChar = ConvertChar::get(tc->hap[col - 1]);
+    if (hapChar == AMBIG_CHAR) {
+      for (int ci = 0; ci < NUM_DISTINCT_CHARS; ++ci) maskArr[mIndex][ci] |= bitMask;
+    }
+    maskArr[mIndex][hapChar] |= bitMask;
+  }
+
+  const Vec<T> one = vsplat<T>(T(1.0));
+  const Vec<T> three = vsplat<T>(T(3.0));
+  T result = zero;
+
+  for (int i = 0; i < stripes; i++) {
+    const bool last = i == stripes - 1;
+    const Vec<T> pMM = vload(p_MM + i * lanes), pGAPM = vload(p_GAPM + i * lanes);
+    const Vec<T> pMX = vload(p_MX + i * lanes), pXX = vload(p_XX + i * lanes);
+    const Vec<T> pMY = vload(p_MY + i * lanes), pYY = vload(p_YY + i * lanes);
+    Vec<T> distm = vload(distm1D + i * lanes);
+    Vec<T> oneMinusDistm;
+    oneMinusDistm.lo = L::sub(one.lo, distm.lo);
+    oneMinusDistm.hi = L::sub(one.hi, distm.hi);
+    distm.lo = L::div(distm.lo, three.lo);
+    distm.hi = L::div(distm.hi, three.hi);
+
+    Vec<T> M2 = vsplat<T>(zero), X2 = vsplat<T>(zero), M1, X1, Y2, Y1;
+    if (i == 0) {
+      M1 = vsplat<T>(zero);
+      X1 = vsplat<T>(zero);
+      Y2 = vlane0<T>(init_Y);
+      Y1 = vsplat<T>(zero);
+    } else {
+      X1 = vlane0<T>(shiftOutX[lanes]);
+      M1 = vlane0<T>(shiftOutM[lanes]);
+      Y2 = vsplat<T>(zero);
+      Y1 = vsplat<T>(zero);
+    }
+    Vec<T> My = M1;
+
+    const int rows = last ? (remainingRows == 0 ? lanes : remainingRows) : lanes;
+    int rsArr[lanes];
+    MaskT lastMaskShiftOut[lanes];
+    for (int ri = 0; ri < lanes; ++ri) {
+      rsArr[ri] = ri < rows ? ConvertChar::get(tc->rs[ri + i * lanes]) : 0;
+      lastMaskShiftOut[ri] = 0;
+    }
+
+    Vec<T> sumM = vsplat<T>(zero), sumX = vsplat<T>(zero);
+    const int end = last ? COLS + rows - 1 : COLS + lanes;
+    for (int begin_d = 1; begin_d < end; begin_d += maskBits) {
+      const int count = std::min(maskBits, end - begin_d);
+      const int maskIndex = (begin_d - 1) / maskBits;
+      MaskT laneMasks[lanes];
+      for (int ei = 0; ei < lanes; ++ei) {
+        /* SET_MASK_WORD from the AVX template, with the shift-by-width case made explicit. */
+        MaskT src = maskArr[maskIndex][rsArr[ei]];
+        MaskT next = ei == 0 ? 0 : (MaskT)((src & ((((MaskT)1) << ei) - 1)) << (maskBits - ei));
+        laneMasks[ei] = (MaskT)(src >> ei) | lastMaskShiftOut[ei];
+        lastMaskShiftOut[ei] = next;
+      }
+      if (last) {
+        run_diagonals<T, true>(begin_d, count, laneMasks, M2, M1, X2, X1, Y2, Y1, My, distm, oneMinusDistm, pMM,
+                               pGAPM, pMX, pXX, pMY, pYY, shiftOutM, shiftOutX, shiftOutY, sumM, sumX);
+      } else {
+        run_diagonals<T, false>(begin_d, count, laneMasks, M2, M1, X2, X1, Y2, Y1, My, distm, oneMinusDistm, pMM,
+                                pGAPM, pMX, pXX, pMY, pYY, shiftOutM, shiftOutX, shiftOutY, sumM, sumX);
+      }
+    }
+    if (last) {
+      T sum[lanes];
+      L::store(sum, L::add(sumM.lo, sumX.lo));
+      L::store(sum + L::kHalf, L::add(sumM.hi, sumX.hi));
+      result = sum[rows - 1];
+    }
+  }
+  return result;
+}
+
+}  // namespace wgse_neon
+
+#endif
