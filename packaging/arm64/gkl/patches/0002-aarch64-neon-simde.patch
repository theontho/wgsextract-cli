diff --git a/src/main/native/common/simd_compat.h b/src/main/native/common/simd_compat.h
new file mode 100644
index 0000000..98036ec
--- /dev/null
+++ b/src/main/native/common/simd_compat.h
@@ -0,0 +1,61 @@
+#ifndef WGSE_SIMD_COMPAT_H
+#define WGSE_SIMD_COMPAT_H
+
+#if defined(__aarch64__) || defined(_M_ARM64)
+  /*
+   * AArch64: SIMDe provides the AVX/AVX2 types and setup code; the PairHMM
+   * (neon-pairhmm.h) and Smith-Waterman (avx2-functions.h) hot loops use native
+   * NEON. Every lane operation (add, sub, mul, div, compare, blend, int32->float
+   * conversion, lane shifts) is an exactly rounded IEEE-754 or integer operation
+   * on both ISAs, so with contraction disabled (-ffp-contract=off) the per-cell
+   * operation order and results match AVX.
+   */
+  #define WGSE_GKL_NEON 1
+  #define SIMDE_ENABLE_NATIVE_ALIASES
+  #include <simde/x86/avx2.h>
+  /* Type-only: GKL's shared PairHMM unions name the AVX-512 vector types. */
+  #include <simde/x86/avx512/types.h>
+  #include <stdint.h>
+
+  /* x86 aligned-allocation helpers used by the Smith-Waterman kernel. */
+  #include <stdlib.h>
+  #if defined(_WIN32)
+    #include <malloc.h>
+    static inline void* _mm_malloc(size_t size, size_t align) { return _aligned_malloc(size, align); }
+    static inline void _mm_free(void* ptr) { _aligned_free(ptr); }
+  #else
+    static inline void* _mm_malloc(size_t size, size_t align) {
+      void* ptr = NULL;
+      return posix_memalign(&ptr, align < sizeof(void*) ? sizeof(void*) : align, size) ? NULL : ptr;
+    }
+    static inline void _mm_free(void* ptr) { free(ptr); }
+  #endif
+
+  /* FPCR.FZ (bit 24) flushes denormal inputs and outputs, i.e. MXCSR FTZ+DAZ. */
+  #define WGSE_FPCR_FZ (UINT64_C(1) << 24)
+
+  static inline uint64_t wgse_get_fpcr(void) {
+    uint64_t value;
+    __asm__ __volatile__("mrs %0, fpcr" : "=r"(value));
+    return value;
+  }
+
+  static inline void wgse_set_fpcr(uint64_t value) {
+    __asm__ __volatile__("msr fpcr, %0" : : "r"(value) : "memory");
+  }
+
+  /* SIMDe's FTZ emulation is a no-op on Arm; map GKL's FTZ calls to FPCR.FZ. */
+  #undef _MM_GET_FLUSH_ZERO_MODE
+  #undef _MM_SET_FLUSH_ZERO_MODE
+  #define _MM_GET_FLUSH_ZERO_MODE() \
+    ((wgse_get_fpcr() & WGSE_FPCR_FZ) ? _MM_FLUSH_ZERO_ON : _MM_FLUSH_ZERO_OFF)
+  #define _MM_SET_FLUSH_ZERO_MODE(mode) \
+    wgse_set_fpcr((mode) == _MM_FLUSH_ZERO_ON \
+        ? (wgse_get_fpcr() | WGSE_FPCR_FZ) : (wgse_get_fpcr() & ~WGSE_FPCR_FZ))
+#elif defined(_MSC_VER)
+  #include <intrin.h>
+#else
+  #include <x86intrin.h>
+#endif
+
+#endif
