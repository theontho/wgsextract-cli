+    const __m128i weights = _mm_set1_epi16(0x0110);
+#endif
     for (i = 0; i + NN < l_seq; i += NN) {
         int j;
         const uint8_t *u2 = useq+i;
+#if defined(__SSSE3__)
+        __m128i bases = _mm_loadu_si128((const __m128i *)u2);
+        __m128i eligible = _mm_cmpeq_epi8(_mm_and_si128(bases, high_bits), ascii_letters);
+        if (_mm_movemask_epi8(eligible) == 0xffff) {
+            __m128i lower = _mm_cmpeq_epi8(_mm_and_si128(bases, bit4), zero);
+            __m128i codes = _mm_or_si128(
+                _mm_and_si128(lower, _mm_shuffle_epi8(table40, bases)),
+                _mm_andnot_si128(lower, _mm_shuffle_epi8(table50, bases)));
+            __m128i pairs = _mm_maddubs_epi16(codes, weights);
+            _mm_storel_epi64((__m128i *)cp, _mm_packus_epi16(pairs, zero));
+            cp += NN/2;
+            continue;
+        }
+#endif
         for (j = 0; j < NN/2; j++)
