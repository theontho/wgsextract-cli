 #define NN 16
     const uint8_t *useq = (uint8_t *)seq;
+#if defined(__SSSE3__)
+    const __m128i table40 = _mm_loadu_si128((const __m128i *)(seq_nt16_table + 0x40));
+    const __m128i table50 = _mm_loadu_si128((const __m128i *)(seq_nt16_table + 0x50));
+    const __m128i high_bits = _mm_set1_epi8((char)0xc0);
+    const __m128i ascii_letters = _mm_set1_epi8(0x40);
+    const __m128i bit4 = _mm_set1_epi8(0x10);
