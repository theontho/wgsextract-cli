+/* Resolve independent suffix-array walks together, retaining their input order. */
+void bwt_sa_many(const bwt_t *bwt, size_t n, bwtint_t *positions)
+{
+	struct { bwtint_t k, steps; size_t out; int active; } lane[4] = {{0}};
+	bwtint_t mask = bwt->sa_intv - 1;
+	size_t next = 0, done = 0;
+	int i;
+	if (n == 1) { positions[0] = bwt_sa(bwt, positions[0]); return; }
+	while (done < n) {
+		for (i = 0; i < 4; ++i) {
+			if (!lane[i].active && next < n) {
+				lane[i].k = positions[next];
+				lane[i].steps = 0;
+				lane[i].out = next++;
+				lane[i].active = 1;
+			}
+			if (lane[i].active && !(lane[i].k & mask)) {
+				positions[lane[i].out] = lane[i].steps + bwt->sa[lane[i].k / bwt->sa_intv];
+				lane[i].active = 0;
+				++done;
+			}
+		}
+#if defined(__GNUC__) || defined(__clang__)
+		for (i = 0; i < 4; ++i)
+			if (lane[i].active && lane[i].k != bwt->primary)
+				__builtin_prefetch(bwt_occ_intv(bwt, lane[i].k - (lane[i].k > bwt->primary)), 0, 3);
+#endif
+		for (i = 0; i < 4; ++i) {
+			if (!lane[i].active) continue;
+			++lane[i].steps;
+			lane[i].k = bwt_invPsi(bwt, lane[i].k);
+		}
+	}
+}
