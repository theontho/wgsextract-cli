diff --git a/src/main/native/common/ScopedFtzDaz.h b/src/main/native/common/ScopedFtzDaz.h
new file mode 100644
index 0000000..4cf3575
--- /dev/null
+++ b/src/main/native/common/ScopedFtzDaz.h
@@ -0,0 +1,19 @@
+#ifndef WGSE_SCOPED_FTZ_DAZ_H
+#define WGSE_SCOPED_FTZ_DAZ_H
+
+#include <immintrin.h>
+
+class ScopedFtzDaz {
+    unsigned int saved_;
+public:
+    ScopedFtzDaz() : saved_(_mm_getcsr()) {
+        _mm_setcsr(saved_ | 0x8040);
+    }
+    ~ScopedFtzDaz() {
+        _mm_setcsr(saved_);
+    }
+    ScopedFtzDaz(const ScopedFtzDaz&) = delete;
+    ScopedFtzDaz& operator=(const ScopedFtzDaz&) = delete;
+};
+
+#endif
