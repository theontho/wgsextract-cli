 #include "jsonreporter.h"
 
+// The command line holds file paths, which may contain backslashes (every
+// Windows path) or quotes; escape them so the report stays valid JSON.
+static string jsonEscape(const string& text) {
+    string escaped;
+    for (char c : text) {
+        if (c == '"' || c == '\\')
+            escaped += '\\';
+        escaped += c;
+    }
+    return escaped;
+}
+
