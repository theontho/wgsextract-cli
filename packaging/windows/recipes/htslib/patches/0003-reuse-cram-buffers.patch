+/* Reuse large malloc-owned CRAM buffers instead of returning their pages to
+ * the OS after every block.  The glibc path also permits sanitizer testing.
+ * Every returned pointer remains a normal malloc/realloc/free-compatible one. */
+#if defined(_WIN32) || (defined(__GLIBC__) && defined(__SANITIZE_ADDRESS__))
+#include <malloc.h>
+#ifdef __SANITIZE_ADDRESS__
+#include <sanitizer/asan_interface.h>
+#define CRAM_BUFFER_POISON(p, n) __asan_poison_memory_region((p), (n))
+#define CRAM_BUFFER_UNPOISON(p, n) __asan_unpoison_memory_region((p), (n))
+#else
+#define CRAM_BUFFER_POISON(p, n) ((void)0)
+#define CRAM_BUFFER_UNPOISON(p, n) ((void)0)
+#endif
+#define CRAM_BUFFER_MIN (64 * 1024)
+#define CRAM_BUFFER_MAX (8 * 1024 * 1024)
+#define CRAM_BUFFER_LIMIT (16 * 1024 * 1024)
+#define CRAM_BUFFER_SLOTS 16
+static struct { void *data; size_t size; unsigned bucket; } cram_buffers[CRAM_BUFFER_SLOTS];
+static size_t cram_buffer_bytes;
+static int cram_buffer_count, cram_buffer_stopped;
+static pthread_mutex_t cram_buffer_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t cram_buffer_once = PTHREAD_ONCE_INIT;
+
+static void cram_buffer_finish(void) {
+    if (pthread_mutex_lock(&cram_buffer_lock) != 0)
+        return;
+    cram_buffer_stopped = 1;
+    while (cram_buffer_count) {
+        void *data = cram_buffers[--cram_buffer_count].data;
+        cram_buffers[cram_buffer_count].data = NULL;
+        cram_buffers[cram_buffer_count].size = 0;
+        cram_buffers[cram_buffer_count].bucket = 0;
+        free(data);
+    }
+    cram_buffer_bytes = 0;
+    pthread_mutex_unlock(&cram_buffer_lock);
+}
+
+static void cram_buffer_init(void) {
+    if (atexit(cram_buffer_finish) != 0)
+        cram_buffer_stopped = 1;
+}
+
+static void *cram_buffer_malloc(size_t size) {
+    int saved_errno = errno;
+    if (size >= CRAM_BUFFER_MIN && size <= CRAM_BUFFER_MAX &&
+        pthread_once(&cram_buffer_once, cram_buffer_init) == 0 &&
+        pthread_mutex_lock(&cram_buffer_lock) == 0) {
+        int best = -1;
+        if (!cram_buffer_stopped) {
+            for (int i = 0; i < cram_buffer_count; i++)
+                if (cram_buffers[i].size >= size &&
+                    cram_buffers[i].size - size <= size / 8 &&
+                    (best < 0 || cram_buffers[i].size < cram_buffers[best].size))
+                    best = i;
+        }
+        if (best >= 0) {
+            void *data = cram_buffers[best].data;
+            size_t capacity = cram_buffers[best].size;
+            cram_buffer_bytes -= capacity;
+            cram_buffers[best] = cram_buffers[--cram_buffer_count];
+            cram_buffers[cram_buffer_count].data = NULL;
+            cram_buffers[cram_buffer_count].size = 0;
+            cram_buffers[cram_buffer_count].bucket = 0;
+            pthread_mutex_unlock(&cram_buffer_lock);
+            CRAM_BUFFER_UNPOISON(data, size);
+            errno = saved_errno;
+            return data;
+        }
+        pthread_mutex_unlock(&cram_buffer_lock);
+    }
+    errno = saved_errno;
+    return malloc(size);
+}
+
+static void cram_buffer_free(void *data) {
+    int saved_errno = errno;
+    if (!data)
+        return;
+#ifdef _WIN32
+    size_t size = _msize(data);
+#else
+    size_t size = malloc_usable_size(data);
+#endif
+    if (size >= CRAM_BUFFER_MIN && size <= CRAM_BUFFER_MAX &&
+        pthread_once(&cram_buffer_once, cram_buffer_init) == 0 &&
+        pthread_mutex_lock(&cram_buffer_lock) == 0) {
+        unsigned bucket = 0, peers = 0;
+        for (size_t upper = CRAM_BUFFER_MIN; upper < size; upper *= 2)
+            bucket++;
+        for (int i = 0; i < cram_buffer_count; i++)
+            peers += cram_buffers[i].bucket == bucket;
+        if (!cram_buffer_stopped && peers < 2 && cram_buffer_count < CRAM_BUFFER_SLOTS &&
+            cram_buffer_bytes <= CRAM_BUFFER_LIMIT - size) {
+            CRAM_BUFFER_POISON(data, size);
+            cram_buffers[cram_buffer_count].data = data;
+            cram_buffers[cram_buffer_count].bucket = bucket;
+            cram_buffers[cram_buffer_count++].size = size;
+            cram_buffer_bytes += size;
+            pthread_mutex_unlock(&cram_buffer_lock);
+            errno = saved_errno;
+            return;
+        }
+        pthread_mutex_unlock(&cram_buffer_lock);
+    }
+    free(data);
+    errno = saved_errno;
+}
+#else
+#define cram_buffer_malloc malloc
+#define cram_buffer_free free
+#endif
+
