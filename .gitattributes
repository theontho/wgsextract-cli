# Force LF line endings for shell scripts to avoid issues in WSL/Linux
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
packaging/windows/recipes/bwa-mem2/tiny-index.sha256 text eol=lf
packaging/windows-arm64/recipes/*/patches/*.patch -whitespace
# cmd.exe needs CRLF batch files: with LF, `goto` and `call :label` miss labels
# (install_windows.bat: "The system cannot find the batch label specified").
# GitHub's source archives apply these attributes too.
*.bat text eol=crlf
*.cmd text eol=crlf

# Vendor output headers must retain their original LF or CRLF bytes.
src/wgsextract_cli/assets/microarray/raw_file_templates/head/* -text whitespace=cr-at-eol

# The CHM13 manifest and payloads are verified byte-for-byte at runtime.
src/wgsextract_cli/assets/microarray/chm13/v1/* -text

# Patches for upstream sources keep their exact bytes (some upstream files are CRLF).
packaging/windows/recipes/**/*.patch -text -whitespace
