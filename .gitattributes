# Force LF line endings for shell scripts to avoid issues in WSL/Linux
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
# cmd.exe needs CRLF batch files: with LF, `goto` and `call :label` miss labels
# (install_windows.bat: "The system cannot find the batch label specified").
# GitHub's source archives apply these attributes too.
*.bat text eol=crlf
*.cmd text eol=crlf

# Patches for upstream sources keep their exact bytes (some upstream files are CRLF).
packaging/windows/recipes/**/*.patch -text
