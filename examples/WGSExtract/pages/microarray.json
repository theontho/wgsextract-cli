      "actions": [
        {
          "id": "microarray-generate",
          "title": "actions.microarray.microarray-formats.microarray-generate.title",
          "tooltip": "actions.microarray.microarray-formats.microarray-generate.tooltip",
          "disabledTooltip": "actions.microarray.microarray-formats.microarray-generate.disabledTooltip",
          "disabledWhen": [
            {
              "placeholder": "bam_path.pathExtension",
              "in": [
                "bai",
                "crai"
              ]
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "microarray",
              "--input",
              "{{bam_path}}",
              "--ref",
              "{{ref_fasta}}",
              "--formats",
              "{{microarray_formats}}"
            ],
            "optionalArguments": [
              [
                "--outdir",
                "{{out_dir}}"
              ],
              [
                "--min-gq",
                "{{microarray_min_gq}}"
              ],
              [
                "--min-dp",
                "{{microarray_min_dp}}"
              ],
              [
                "--strand-ambiguous",
                "{{microarray_strand_ambiguous}}"
              ],
              [
                "{{microarray_resolve_rsids}}"
              ],
              [
                "{{microarray_absent_no_call}}"
              ],
              [
                "{{microarray_exclude_filtered}}"
              ],
              [
                "{{microarray_call_reasons}}"
              ],
              [
                "--aadr-sample-id",
                "{{aadr_sample_id}}"
              ],
              [
                "--aadr-sex",
                "{{aadr_sex}}"
              ],
              [
                "--indel-manifest",
                "{{indel_format}}={{indel_manifest}}"
              ]
            ]
          }
        }
      ]
