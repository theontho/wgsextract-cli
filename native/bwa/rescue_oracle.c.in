
/* wgse: the mate-rescue alignments mem_sam_pe() may run for a pair, for the
 * Metal backend to compute ahead of time. Mirrors mem_sam_pe()'s choice of
 * alignments and mem_matesw()'s windows using the pair's regions before any
 * rescue. Rescued hits only add orientations to skip, so the CPU usually needs
 * a subset; wgse_metal_matesw() looks each one up by its exact inputs and runs
 * ksw_align2() itself for any it does not find. */
static void wgse_rescue_windows(const mem_opt_t *opt, const bntseq_t *bns, const uint8_t *pac,
	const mem_pestat_t pes[4], const mem_alnreg_t *a, int l_ms, const uint8_t *ms,
	const mem_alnreg_v *ma, wgse_rescue_emit_f emit, void *ctx)
{
	int64_t l_pac = bns->l_pac;
	int i, r, skip[4], rid = -1;
	for (r = 0; r < 4; ++r)
		skip[r] = pes[r].failed? 1 : 0;
	for (i = 0; i < ma->n; ++i) {
		int64_t dist;
		r = mem_infer_dir(l_pac, a->rb, ma->a[i].rb, &dist);
		if (dist >= pes[r].low && dist <= pes[r].high)
			skip[r] = 1;
	}
	if (skip[0] + skip[1] + skip[2] + skip[3] == 4) return;
	for (r = 0; r < 4; ++r) {
		int is_rev, is_larger;
		uint8_t *ref = 0;
		int64_t rb, re;
		if (skip[r]) continue;
		is_rev = (r>>1 != (r&1));
		is_larger = !(r>>1);
		if (!is_rev) {
			rb = is_larger? a->rb + pes[r].low : a->rb - pes[r].high;
			re = (is_larger? a->rb + pes[r].high: a->rb - pes[r].low) + l_ms;
		} else {
			rb = (is_larger? a->rb + pes[r].low : a->rb - pes[r].high) - l_ms;
			re = is_larger? a->rb + pes[r].high: a->rb - pes[r].low;
		}
		if (rb < 0) rb = 0;
		if (re > l_pac<<1) re = l_pac<<1;
		if (rb < re) ref = bns_fetch_seq(bns, pac, &rb, (rb+re)>>1, &re, &rid);
		if (ref && a->rid == rid && re - rb >= opt->min_seed_len) {
			int xtra = KSW_XSUBO | KSW_XSTART | (l_ms * opt->a < 250? KSW_XBYTE : 0) | (opt->min_seed_len * opt->a);
			emit(ctx, ms, l_ms, is_rev, rb, re, ref, xtra);
		}
		free(ref);
	}
}

void wgse_rescue_candidates(const mem_opt_t *opt, const bntseq_t *bns, const uint8_t *pac,
	const mem_pestat_t pes[4], const bseq1_t s[2], const mem_alnreg_v a[2],
	wgse_rescue_emit_f emit, void *ctx)
{
	int i, j, n;
	if (opt->flag & MEM_F_NO_RESCUE) return;
	for (i = 0; i < 2; ++i)
		for (j = n = 0; j < a[i].n && n < opt->max_matesw; ++j) {
			if (a[i].a[j].score < a[i].a[0].score - opt->pen_unpaired) continue;
			++n;
			wgse_rescue_windows(opt, bns, pac, pes, &a[i].a[j], s[!i].l_seq,
				(const uint8_t*)s[!i].seq, &a[!i], emit, ctx);
		}
}
